client/web/engine.wasm
client/web/wasm_exec.js
# The page loads only the -v2 JPEG exports and the table background; masters, first-pass
# images and preview captures stay out of git.
client/web/art/*.png
client/web/art/*.jpg
!client/web/art/*-v2.jpg
!client/web/art/duel-table.jpg
client/*.png
client/*.webm
client/mockups/
# Approved Delvers direction and individual illustration exports; keep PNG masters local.
!client/web/art/*-selection-v1.jpg
!client/web/art/*-delvers-v3.jpg
!client/web/art/delvers-selection-v5.jpg
!client/web/art/delvers-portrait-v1.jpg
# The gnotif registry, copied by make deps.
deps/
# The local indexer's database, written by make indexer.
.indexer/
# gnotifd's keys and database, written by make gnotif.
.gnotif/
# The empty gno workspace make dev runs gnodev from.
.gnodev/
# The toolchain and bundled libraries, installed by pnpm.
node_modules/
# The built site, written by make build.
dist/
# direnv's cache of the flake's dev shell, and nix build outputs.
.direnv/
result
result-*
# Track the shared Claude Code settings and keep the rest of .claude/ out.
!/.claude/
/.claude/*
!/.claude/settings.json
# The superpowers skills' plan workspaces and brainstorm mockups.
.superpowers/

# gnopm's assembly: rebuilt from gnomod.lock, never committed.
/.gnopm/
